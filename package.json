{
  "name": "folio-agent-workspace",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "A local research studio for reading papers, connecting evidence, and writing with AI agents",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "mcp": "node src/server.mjs --stdio",
    "test": "node --test test/*.test.mjs",
    "configure": "node scripts/configure.mjs",
    "doctor": "node scripts/doctor.mjs",
    "setup:tex": "node scripts/setup-tex.mjs",
    "check": "node scripts/check-source.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@napi-rs/canvas": "1.0.11",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/kor": "1.0.0",
    "express": "5.3.0",
    "mathjax": "3.2.2",
    "pdfjs-dist": "6.4.299",
    "tesseract.js": "7.0.0",
    "zod": "4.6.7"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sukoji/folio-research.git"
  }
}
